* text=auto

# Boot script must stay LF so bash on AGNOS does not see CRLF syntax errors.
launch_chffrplus.sh text eol=lf

# to move existing files into LFS:
# git add --renormalize .
*.onnx filter=lfs diff=lfs merge=lfs -text
*.svg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# C3 fork: keep UI fonts/training images in plain git (avoid LFS quota on push)
openpilot/selfdrive/assets/fonts/OpFont-*.otf -filter -diff -merge
openpilot/selfdrive/assets/training/*.png -filter -diff -merge

# Docs assets: small PNG that should stay in plain git (no LFS push route available).
docs/assets/comma-logo.png -filter -diff -merge binary

openpilot/selfdrive/car/tests/test_models_segs.txt filter=lfs diff=lfs merge=lfs -text
openpilot/common/hardware/comma/updater filter=lfs diff=lfs merge=lfs -text

# Force CJK SC fonts to be stored as regular git blobs (not LFS),
# because the upstream GitLab LFS server doesn't accept pushes from this
# fork and the fork's own GitHub LFS budget is exhausted.
openpilot/selfdrive/assets/fonts/NotoSansSC-*.otf -filter -diff -merge binary
openpilot/selfdrive/assets/fonts/HarmonyOS_Sans_SC_*.ttf -filter -diff -merge binary
openpilot/selfdrive/assets/fonts/NotoColorEmoji.ttf -filter -diff -merge binary

# Carrot/Amap assets: keep these imported runtime resources as regular Git blobs.
# This overrides the global *.wav and *.png LFS rules for these paths only.
openpilot/selfdrive/assets/sounds/audio_*.wav -filter -diff -merge binary
openpilot/selfdrive/assets/sounds/nnff.wav -filter -diff -merge binary
openpilot/selfdrive/assets/sounds/tici_disengaged.wav -filter -diff -merge binary
openpilot/selfdrive/assets/sounds/tici_engaged.wav -filter -diff -merge binary
openpilot/selfdrive/assets/sounds/traffic_sign_green.wav -filter -diff -merge binary
openpilot/selfdrive/assets/sounds/traffic_sign_changed.wav -filter -diff -merge binary
openpilot/selfdrive/assets/sounds/reverse_gear.wav -filter -diff -merge binary
openpilot/sunnypilot/selfdrive/assets/images/lane_change_l.png -filter -diff -merge binary
openpilot/sunnypilot/selfdrive/assets/images/lane_change_r.png -filter -diff -merge binary
openpilot/sunnypilot/selfdrive/assets/images/turn_r.png -filter -diff -merge binary
openpilot/sunnypilot/selfdrive/assets/images/turn_l.png -filter -diff -merge binary
openpilot/sunnypilot/selfdrive/assets/images/turn_u.png -filter -diff -merge binary

# Legacy/firmware binary blobs that must stay in plain Git (no LFS push route available).
openpilot/selfdrive/pandad/tests/bootstub.panda_h7.bin -filter -diff -merge binary
openpilot/system/hardware/chestnut/firmware_wrapped.bin -filter -diff -merge binary

# Avoid Git LFS for empty __init__.py placeholders; keep them as text blobs.
openpilot/selfdrive/ui/sunnypilot/lib/__init__.py -filter -diff -merge text
openpilot/sunnypilot/carrot/__init__.py -filter -diff -merge text
openpilot/sunnypilot/carrot/tests/__init__.py -filter -diff -merge text
openpilot/sunnypilot/mapd/live_map_data/tests/__init__.py -filter -diff -merge text
openpilot/sunnypilot/selfdrive/controls/lib/accel_controller/tests/__init__.py -filter -diff -merge text
openpilot/sunnypilot/selfdrive/test/__init__.py -filter -diff -merge text
openpilot/sunnypilot/selfdrive/test/longitudinal_maneuvers/__init__.py -filter -diff -merge text
openpilot/sunnypilot/selfdrive/test/longitudinal_maneuvers/tests/__init__.py -filter -diff -merge text
