#: dragonpilot/settings.py
msgid "+ Auto Lane Change after:"
msgstr "+ تغيير المسار تلقائياً بعد:"

#: dragonpilot/settings.py
msgid "0 min = Immediately"
msgstr "0 دقيقة = فوراً"

#: dragonpilot/settings.py
msgid "Adaptive Coasting Mode (ACM) reduces braking to allow smoother coasting when appropriate."
msgstr "وضع الانزلاق التكيفي (ACM) يقلل الفرملة للسماح بانزلاق أكثر سلاسة عند الحاجة."

#: dragonpilot/settings.py
msgid "Adaptive Experimental Mode (AEM)"
msgstr "الوضع التجريبي التكيفي (AEM)"

#: dragonpilot/settings.py
msgid "Adaptive Personality Mode (APM)"
msgstr "وضع الشخصية التكيفي (APM)"

#: dragonpilot/settings.py
msgid "Adaptive mode switcher between ACC and Blended based on driving context."
msgstr "مبدل الوضع التكيفي بين ACC ومختلط حسب سياق القيادة."

#: dragonpilot/settings.py
msgid "All"
msgstr "الكل"

#: dragonpilot/settings.py
msgid "Allow openpilot to obey right-hand traffic conventions on right driver seat."
msgstr "السماح لـ openpilot بالالتزام بقواعد المرور اليمنى على مقعد السائق الأيمن."

#: dragonpilot/settings.py
msgid "Always-on Lane Keeping Assist (ALKA)"
msgstr "مساعد الحفاظ على المسار الدائم (ALKA)"

#: dragonpilot/selfdrive/ui/layouts/settings/dragonpilot.py
msgid "Are you sure you want to reset ALL DP SETTINGS to default?"
msgstr "هل أنت متأكد من إعادة تعيين جميع إعدادات DP إلى الافتراضية؟"

#: dragonpilot/settings.py
msgid "Audible Alert"
msgstr "التنبيه الصوتي"

#: dragonpilot/settings.py
msgid "Auto Shutdown After"
msgstr "الإيقاف التلقائي بعد"

#: dragonpilot/settings.py
msgid "Automatically switches personality to \"Aggressive\" below 30 km/h and restores your selected personality above 40 km/h."
msgstr "Automatically switches personality to \"Aggressive\" below 30 km/h and restores your selected personality above 40 km/h."

#: dragonpilot/settings.py
msgid "Avoid EPS Lockout"
msgstr "تجنب قفل نظام التوجيه الكهربائي"

#: dragonpilot/settings.py
msgid "Block lane change assist when the system detects the road edge.<br>NOTE: This will show 'Car Detected in Blindspot' warning."
msgstr "منع مساعد تغيير المسار عند اكتشاف النظام لحافة الطريق.<br>ملاحظة: سيظهر تحذير 'اكتشاف سيارة في النقطة العمياء'."

#: dragonpilot/settings.py
msgid "Broadcasts telemetry to the opview App (available on Android). Requires the companion App to be running on an external display."
msgstr "Broadcasts telemetry to the opview App (available on Android). Requires the companion App to be running on an external display."

#: dragonpilot/settings.py
msgid "DTSC automatically adjusts the vehicle's predicted speed based on upcoming road curvature and grip conditions.<br>Originally from the openpilot TACO branch."
msgstr "يقوم DTSC بضبط السرعة المتوقعة للمركبة تلقائياً بناءً على انحناء الطريق القادم وظروف التماسك.<br>مأخوذ أصلاً من فرع openpilot TACO."

#: dragonpilot/settings.py
msgid "Delay Starting Loggerd for:"
msgstr "تأخير تشغيل المسجل لمدة:"

#: dragonpilot/settings.py
msgid "Delays the startup of loggerd and its related processes when the device goes on-road.<br>This prevents the initial moments of a drive from being recorded, protecting location privacy at the start of a trip."
msgstr "يؤخر بدء تشغيل المسجل والعمليات المرتبطة به عند دخول الجهاز على الطريق.<br>هذا يمنع تسجيل اللحظات الأولى من الرحلة، مما يحمي خصوصية الموقع في بداية الرحلة."

#: dragonpilot/settings.py
msgid "Disable Comma Connect"
msgstr "تعطيل Comma Connect"

#: dragonpilot/settings.py
msgid "Disable Comma connect service if you do not wish to upload / being tracked by the service."
msgstr "تعطيل خدمة Comma Connect إذا كنت لا ترغب في الرفع / أو تتبعك من قبل الخدمة."

#: dragonpilot/settings.py
msgid "Display Lead Stats"
msgstr "عرض إحصائيات السيارة الأمامية"

#: dragonpilot/settings.py
msgid "Display Mode"
msgstr "وضع العرض"

#: dragonpilot/settings.py
msgid "Display the statistics of lead car and/or radar tracking points.<br>Lead: Lead stats only<br>Radar: Radar tracking point stats only<br>All: Lead and Radar stats<br>NOTE: Radar option only works on certain vehicle models."
msgstr "عرض إحصائيات السيارة الأمامية و/أو نقاط تتبع الرادار.<br>أمامية: إحصائيات السيارة الأمامية فقط<br>رادار: إحصائيات نقاط تتبع الرادار فقط<br>الكل: إحصائيات السيارة الأمامية والرادار<br>ملاحظة: خيار الرادار يعمل فقط على بعض موديلات المركبات."

#: dragonpilot/settings.py
msgid "Door Auto Lock/Unlock"
msgstr "قفل/فتح الأبواب تلقائياً"

#: dragonpilot/settings.py
msgid "Dynamic Accel Slew Rate (DASR)"
msgstr "معدل تسارع ديناميكي (DASR)"

#: dragonpilot/settings.py
msgid "Dynamic Turn Speed Control (DTSC)"
msgstr "التحكم الديناميكي بسرعة الانعطاف (DTSC)"

#: dragonpilot/settings.py
msgid "Enable Adaptive Coasting Mode (ACM)"
msgstr "تفعيل وضع الانزلاق التكيفي (ACM)"

#: dragonpilot/settings.py
msgid "Enable Beep (Warning)"
msgstr "تفعيل الصفارة (تحذير)"

#: dragonpilot/settings.py
msgid "Enable Right-Hand Drive Mode"
msgstr "تفعيل وضع القيادة اليمنى"

#: dragonpilot/settings.py
msgid "Enable TSS1 SnG Mod"
msgstr "تفعيل تعديل TSS1 للتوقف والانطلاق"

#: dragonpilot/settings.py
msgid "Enable lateral control even when ACC/cruise is disengaged, using ACC Main or LKAS button to toggle. Vehicle must be moving."
msgstr "تفعيل التحكم الجانبي حتى عند إيقاف ACC/التثبيت، باستخدام زر ACC Main أو LKAS للتبديل. يجب أن تكون المركبة متحركة."

#: dragonpilot/settings.py
msgid "Enable openpilot to auto-lock doors above 20 km/h and auto-unlock when shifting to Park."
msgstr "تمكين openpilot من قفل الأبواب تلقائياً فوق 20 كم/س وفتحها تلقائياً عند التحويل إلى وضع الركن."

#: dragonpilot/settings.py
msgid "Enable opview"
msgstr "تفعيل opview"

#: dragonpilot/settings.py
msgid "Fine-tune where the car drives within the lane. Positive values move the car left, negative values move right.<br>Recommended to start with small values (±5cm) and adjust based on preference."
msgstr "Fine-tune where the car drives within the lane. Positive values move the car left, negative values move right.<br>Recommended to start with small values (±5cm) and adjust based on preference."

#: dragonpilot/settings.py
msgid "Hide HUD When Moves above:"
msgstr "إخفاء شاشة العرض عند الحركة فوق:"

#: dragonpilot/settings.py
msgid "Lane Change Assist At:"
msgstr "مساعد تغيير المسار عند:"

#: dragonpilot/settings.py
msgid "Lead"
msgstr "أمامية"

#: dragonpilot/settings.py
msgid "MAIN+"
msgstr "MAIN+"

#: dragonpilot/settings.py
msgid "MAIN-"
msgstr "MAIN-"

#: dragonpilot/settings.py
msgid "MQB A0 SnG Mod"
msgstr "تعديل MQB A0 للتوقف والانطلاق"

#: dragonpilot/settings.py
msgid "OP+"
msgstr "OP+"

#: dragonpilot/settings.py
msgid "OP-"
msgstr "OP-"

#: dragonpilot/settings.py
#: dragonpilot/settings.py:193 dragonpilot/settings.py
#: dragonpilot/settings.py:255 dragonpilot/settings.py
#: dragonpilot/settings.py:84 dragonpilot/settings.py
msgid "Off"
msgstr "إيقاف"

#: dragonpilot/settings.py
msgid "Off = Disable Auto Lane Change."
msgstr "إيقاف = تعطيل تغيير المسار التلقائي."

#: dragonpilot/settings.py
msgid "Off = Disable LCA.<br>1 mph = 1.2 km/h."
msgstr "إيقاف = تعطيل مساعد تغيير المسار.<br>1 ميل/س = 1.2 كم/س."

#: dragonpilot/settings.py
msgid "PQ Steering Patch"
msgstr "تصحيح توجيه PQ"

#: dragonpilot/settings.py
msgid "Position Offset"
msgstr "إزاحة الموضع"

#: dragonpilot/selfdrive/ui/layouts/settings/dragonpilot.py
msgid "RESET"
msgstr "إعادة تعيين"

#: dragonpilot/settings.py
msgid "Radar"
msgstr "رادار"

#: dragonpilot/settings.py
msgid "Rainbow Driving Path like Tesla"
msgstr "مسار قيادة قوس قزح مثل تسلا"

#: dragonpilot/selfdrive/ui/layouts/settings/dragonpilot.py
msgid "Reset"
msgstr "إعادة تعيين"

#: dragonpilot/selfdrive/ui/layouts/settings/dragonpilot.py
msgid "Reset DP Settings"
msgstr "إعادة تعيين إعدادات DP"

#: dragonpilot/selfdrive/ui/layouts/settings/dragonpilot.py
msgid "Reset dragonpilot settings to default and restart the device."
msgstr "إعادة تعيين إعدادات dragonpilot إلى الافتراضية وإعادة تشغيل الجهاز."

#: dragonpilot/settings.py
msgid "Road Edge Detection (RED)"
msgstr "اكتشاف حافة الطريق (RED)"

#: dragonpilot/settings.py
msgid "See https://github.com/eFiniLan/openpilot-ext-radar-addon for more information."
msgstr "انظر https://github.com/eFiniLan/openpilot-ext-radar-addon لمزيد من المعلومات."

#: dragonpilot/settings.py
msgid "Speed-dependent acceleration smoothing. Allows faster accel changes at low speeds for responsive city driving, smoother changes at highway speeds for comfort."
msgstr "Speed-dependent acceleration smoothing. Allows faster accel changes at low speeds for responsive city driving, smoother changes at highway speeds for comfort."

#: dragonpilot/settings.py:176 dragonpilot/settings.py
msgid "Std."
msgstr "قياسي"

#: dragonpilot/settings.py
msgid "Std.: Stock behavior.<br>MAIN+: ACC MAIN on = Display ON.<br>OP+: OP enabled = Display ON.<br>MAIN-: ACC MAIN on = Display OFF<br>OP-: OP enabled = Display OFF."
msgstr "قياسي: السلوك الافتراضي.<br>MAIN+: تشغيل ACC MAIN = تشغيل العرض.<br>OP+: تفعيل OP = تشغيل العرض.<br>MAIN-: تشغيل ACC MAIN = إيقاف العرض.<br>OP-: تفعيل OP = إيقاف العرض."

#: dragonpilot/settings.py
msgid "Std.: Stock behaviour.<br>Warning: Only emits sound when there is a warning.<br>Off: Does not emit any sound at all."
msgstr "قياسي: السلوك الافتراضي.<br>تحذير: يصدر صوتاً فقط عند وجود تحذير.<br>إيقاف: لا يصدر أي صوت على الإطلاق."

#: dragonpilot/settings.py
msgid "To prevent screen burn-in, hide Speed, MAX Speed, and Steering/DM Icons when the car moves.<br>Off = Stock Behavior<br>1 km/h = 0.6 mph"
msgstr "لمنع احتراق الشاشة، إخفاء السرعة والسرعة القصوى وأيقونات التوجيه/DM عند تحرك السيارة.<br>إيقاف = السلوك الافتراضي<br>1 كم/س = 0.6 ميل/س"

#: dragonpilot/settings.py
msgid "Use Buzzer for audiable alerts."
msgstr "استخدام الصفارة للتنبيهات الصوتية."

#: dragonpilot/settings.py
msgid "Use External Radar"
msgstr "استخدام رادار خارجي"

#: dragonpilot/settings.py
msgid "Use MICI (comma four) UI"
msgstr "استخدام واجهة MICI (comma four)"

#: dragonpilot/settings.py
msgid "Use Stock Longitudinal Control"
msgstr "استخدام التحكم الطولي الافتراضي"

#: dragonpilot/settings.py
msgid "Warning"
msgstr "تحذير"

#: dragonpilot/settings.py:199 dragonpilot/settings.py
msgid "Why not?"
msgstr "لم لا؟"

