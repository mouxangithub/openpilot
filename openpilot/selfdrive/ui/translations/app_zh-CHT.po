msgstr "重新同步巡航設定速度的速度。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Speed at which the driver can resume auto gas after pressing the brake."
msgstr "踩煞車後可恢復自動油門的速度。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Following Distance"
msgstr "跟車距離"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
