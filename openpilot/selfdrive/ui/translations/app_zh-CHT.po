#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Configure how openpilot automatically engages cruise control and sets speed."
msgstr "設定 openpilot 如何自動開啟巡航並設定速度。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "0=Off, 1=Auto engage when conditions met, 2=Auto engage with brake release."
msgstr "0=關閉，1=條件滿足時自動開啟，2=鬆開煞車後自動開啟。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Automatically set cruise speed from road limit or nav speed."
msgstr "根據道路限速或導航速度自動設定巡航速度。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Distance in meters to automatically enable cruise when a lead car is detected (0=disabled)."
msgstr "偵測到前車時自動開啟巡航的距離，單位公尺（0=停用）。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Steering Wheel Buttons"
msgstr "方向盤按鍵"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
