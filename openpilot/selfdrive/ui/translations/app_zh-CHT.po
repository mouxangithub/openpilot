msgstr "LFA/LKAS 按鍵的行為。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Behavior of the steering wheel paddles."
msgstr "方向盤撥片的行為。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Auto Gas"
msgstr "自動油門"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
