msgstr "各檔位巡航跟車時距與動態調整。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Extra following distance added based on speed."
msgstr "依車速額外增加的跟車距離。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Longitudinal Gains"
msgstr "縱向控制增益"

