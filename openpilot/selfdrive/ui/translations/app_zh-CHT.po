msgstr "巡航加減速按鍵的行為。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Keep brakes applied after canceling cruise."
msgstr "取消巡航後保持煞車。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Milliseconds before a long press is registered."
msgstr "長按被識別前的毫秒數。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Speed Presets"
msgstr "速度預設"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
