msgstr "駕駛人介入後自動恢復油門。"

#: openpilot\selfdrive\ui\sunnypilot\layouts\settings\carrot_tuning.py
msgid "Speed threshold below which auto gas is disabled."
msgstr "自動油門停用的速度閾值。"

