import importlib.util
import json
from pathlib import Path

Import('env', 'arch', 'common')

# build the fonts
generator = File("#openpilot/selfdrive/assets/fonts/process.py")
languages_file = File("#openpilot/selfdrive/ui/translations/languages.json")
source_files = Glob("#openpilot/selfdrive/assets/fonts/*.ttf") + Glob("#openpilot/selfdrive/assets/fonts/*.otf")
source_files = [f for f in source_files if "NotoColor" not in f.name]

with open(languages_file.abspath, encoding="utf-8") as f:
  lang_codes = list(json.load(f).values())

output_files = []
for f in source_files:
  base = Path(f.path).with_suffix('')
  if base.name.startswith("OpFont"):
    output_files.extend([f"#{base}-Labels.fnt", f"#{base}-Labels.png"])
    for code in lang_codes:
      output_files.extend([f"#{base}-{code}.fnt", f"#{base}-{code}.png"])
  else:
    output_files.extend([f"#{base}.fnt", f"#{base}.png"])

env.Command(
  target=output_files,
  source=[generator, source_files, languages_file],
  action=f"python3 {generator}",
)

if GetOption('extras') and arch == "comma_arm64":
  # build installers
  raylib_dir = Path(importlib.util.find_spec("raylib").submodule_search_locations[0]) / "install"
  raylib_env = env.Clone()
  raylib_env['CPPPATH'] += [str(raylib_dir / "include")]
  raylib_env['LIBPATH'] += [str(raylib_dir / "lib")]
  raylib_env['LINKFLAGS'].append('-Wl,-strip-debug')

  raylib_libs = common + ["raylib_comma", "GLESv2", "EGL", "gbm", "drm"]

  release = "release3"
  installers = [
    ("openpilot", release),
    ("openpilot_test", f"{release}-staging"),
    ("openpilot_nightly", "nightly"),
    ("openpilot_internal", "nightly-dev"),
  ]

  cont = raylib_env.Command("installer/continue_openpilot.o", "installer/continue_openpilot.sh",
                            "ld -r -b binary -o $TARGET $SOURCE")
  inter = raylib_env.Command("installer/inter_ttf.o", "installer/inter-ascii.ttf",
                             "ld -r -b binary -o $TARGET $SOURCE")
  inter_bold = raylib_env.Command("installer/inter_bold.o", "../assets/fonts/Inter-Bold.ttf",
                              "ld -r -b binary -o $TARGET $SOURCE")
  inter_light = raylib_env.Command("installer/inter_light.o", "../assets/fonts/Inter-Light.ttf",
                              "ld -r -b binary -o $TARGET $SOURCE")
  for name, branch in installers:
    d = {'BRANCH': f"'\"{branch}\"'"}
    if "internal" in name:
      d['INTERNAL'] = "1"

    obj = raylib_env.Object(f"installer/installers/installer_{name}.o", ["installer/installer.cc"], CPPDEFINES=d)
    f = raylib_env.Program(f"installer/installers/installer_{name}", [obj, cont, inter, inter_bold, inter_light], LIBS=raylib_libs)
    # keep installers small
    assert f[0].get_size() < 2500*1e3, f[0].get_size()

  # Unpatched template for self-hosted fork installer PHP (openpilot-installer-generator)
  d_fork = {'INSTALLER_USE_PLACEHOLDERS': '1'}
  obj_fork = raylib_env.Object("installer/installers/installer_fork_template.o", ["installer/installer.cc"], CPPDEFINES=d_fork)
  f_fork = raylib_env.Program("installer/installers/installer_fork_template", [obj_fork, cont, inter, inter_bold, inter_light], LIBS=raylib_libs)
  assert f_fork[0].get_size() < 2500*1e3, f_fork[0].get_size()
